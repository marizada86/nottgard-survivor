config_version=5

[application]
config/name="ART-032 DRAFT Preview"

[display]
window/size/viewport_width=1000
window/size/viewport_height=560
window/size/window_width_override=1000
window/size/window_height_override=560

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.075, 0.105, 1)
